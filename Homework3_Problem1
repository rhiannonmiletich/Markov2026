% Parameters
a_star = -1 + sqrt(3);
c_star = exp(-a_star) / (3 * a_star^2 * (1 - a_star));
p_acceptance = 3 * (a_star^2) * (1 - a_star) * exp(a_star)

% Define x range
x = linspace(0, 10, 500);

% Target density f(x)
f = (1/3) * x .* (1 + x) .* exp(-x);

% Proposal scaled by c(a*)
g = c_star * (a_star^2) * x .* exp(-a_star * x);

% Plot
figure;
plot(x, f, 'LineWidth', 2, 'DisplayName', 'f(x) (Target)');
hold on;
plot(x, g, '--', 'LineWidth', 2, 'DisplayName', 'c(a^*) g_{a^*}(x) (Proposal)');
hold off;

xlabel('x');
ylabel('Density');
title('Target Density f(x) and Scaled Proposal c(a^*) g_{a^*}(x)');
legend('show');
grid on;
