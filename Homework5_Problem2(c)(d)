FOR SIMULATION AND HISTOGRAM IN PART(C):
%% Parameters
a = 0.04;
b = 0.16;
K = 0.1;
n = 5;              % number of states
numSteps = 1e6;     % number of steps to simulate

%% Compute transition probabilities
p = K * exp(a*(1:n));      % probability to move up
q = K * exp(b*(0:n-1));    % probability to move down

% Construct the transition matrix P
P = zeros(n);
P(1,1) = 1 - p(1);  P(1,2) = p(1);
P(2,1) = q(2);       P(2,2) = 1 - p(2) - q(2); P(2,3) = p(2);
P(3,2) = q(3);       P(3,3) = 1 - p(3) - q(3); P(3,4) = p(3);
P(4,3) = q(4);       P(4,4) = 1 - p(4) - q(4); P(4,5) = p(4);
P(5,4) = q(5);       P(5,5) = 1 - q(5);

%% Simulate the Markov chain
state = zeros(numSteps,1);  % vector to store states
state(1) = 1;               % start in state 1 (can be any state)

for t = 2:numSteps
    r = rand;               % random number between 0 and 1
    current = state(t-1);
    % Determine next state
    cumulative = cumsum(P(current,:));  % cumulative probabilities
    next = find(r <= cumulative, 1, 'first'); % choose next state
    state(t) = next;
end

%% Compute fraction of time in each state
fractionTime = zeros(n,1);
for i = 1:n
    fractionTime(i) = sum(state == i) / numSteps;
end

%% Plot histogram
figure;
bar(1:n, fractionTime, 0.5);

