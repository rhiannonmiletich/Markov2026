a = 0.49;
num_sims = 1000;
max_gen = 200;

extinct_count = 0;

for sim = 1:num_sims
    
    X = 1; % start with one particle
    
    for n = 1:max_gen
        
        if X == 0
            extinct_count = extinct_count + 1;
            break;
        end
        
        % Number of reproducing particles (Binomial)
        Z = sum(rand(X,1) < (1 - a));
        
        % Each produces 2 offspring
        X = 2 * Z;
    end
end

% Estimated extinction probability
q_est = extinct_count / num_sims;

disp(['Number of extinct cases: ', num2str(extinct_count)])
disp('Estimated extinction probability:')
disp(q_est)
