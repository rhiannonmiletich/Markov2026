P = [9/10, 1/10, 0;
     0,    7/8,  1/8;
     2/5,  0,    3/5];

P50 = P^50

% Number of time steps
N = 10000;

% State encoding:
% 1 = G 
% 2 = S
% 3 = D

% Transition matrix
P = [9/10, 1/10, 0;
     0,    7/8,  1/8;
     2/5,  0,    3/5];

% Initialize the chain
state = 1;              % start in G
states = zeros(1, N);   % initial row vector of 10,000 zeros

for t = 1:N
    states(t) = state;      % record current state
    
    u = rand;               % uniform random number
    
    % Transition based on current state
    if state == 1           % G
        if u < 1/10
            state = 2;      % move to S
        else
            state = 1;      % stay in G
        end
        
    elseif state == 2       % S
        if u < 1/8
            state = 3;      % move to D
        else
            state = 2;      % stay in S
        end
        
    else                    % D
        if u < 2/5
            state = 1;      % move to G
        else
            state = 3;      % stay in D
        end
    end
end

% Fraction of time spent in G
fraction_G = sum(states == 1) / N
