% Number of machines
n = 5;

% Probabilities
p_work = 0.9;    % machine continues working
p_break = 0.1;   % machine breaks

% Create empty transition matrix
P = zeros(n+1);

% If all machines are broken, 5 new ones are installed
P(1, n+1) = 1;     % state 0 goes to state 5

% Otherwise
for i = 1:n
    for j = 0:i
        P(i+1, j+1) = nchoosek(i,j) * (p_work^j) * (p_break^(i-j));
    end
end

disp(P)


% Matrix A from the linear system

A = [
    0.1       0        0        0        0;
   -0.18     0.19      0        0        0;
   -0.027   -0.243     0.271     0        0;
   -0.0036  -0.0486   -0.2916   0.3439    0;
   -0.00045 -0.0081   -0.0729  -0.32805  0.40951
];

% Right-hand side vector
b = ones(5,1);

% Solve the system A*e = b
e = A \ b;

% Display results
disp('Expected hitting times e1 through e5:')
disp(e)

% Expected time starting from 5 machines
disp('Expected time starting from 5 machines:')
disp(e(5))
